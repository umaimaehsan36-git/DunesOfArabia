@page "/my-bookings"
@layout DunesOfArabia.Components.Layout.MainLayout
@rendermode InteractiveServer

@inject IBookingService BookingService
@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JS

@using System.IdentityModel.Tokens.Jwt

<PageTitle>My Bookings – Dunes of Arabia</PageTitle>

<div class="my-bookings-page">
    @if (!isAuthenticated)
    {
        <div class="not-authenticated">
            <h2>Please log in to view your bookings</h2>
            @* FIX: login URL casing — Identity uses /Account/Login *@
            <a href="/Account/Login?returnUrl=/my-bookings" class="btn-primary">Go to Login</a>
        </div>
    }
    else if (bookings == null)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading your bookings...</p>
        </div>
    }
    else
    {
        <div class="bookings-container">
            <div class="page-header">
                <h1>My Bookings</h1>
                <p>@bookings.Count booking(s) found</p>
            </div>

            <div class="filter-tabs">
                <button @onclick='() => FilterByStatus("all")' class="@(selectedStatus == "all" ? "active" : "")">
                    All (@bookings.Count)
                </button>
                <button @onclick='() => FilterByStatus("upcoming")' class="@(selectedStatus == "upcoming" ? "active" : "")">
                    Upcoming (@upcomingCount)
                </button>
                <button @onclick='() => FilterByStatus("completed")' class="@(selectedStatus == "completed" ? "active" : "")">
                    Completed (@completedCount)
                </button>
                <button @onclick='() => FilterByStatus("cancelled")' class="@(selectedStatus == "cancelled" ? "active" : "")">
                    Cancelled (@cancelledCount)
                </button>
            </div>

            @if (filteredBookings.Any())
            {
                <div class="bookings-list">
                    @foreach (var booking in filteredBookings.OrderByDescending(x => x.CreatedDate))
                    {
                        <div class="booking-card">
                            <div class="booking-image">
                                <img src="@booking.Destination?.ImageUrl" alt="@booking.Destination?.Name"/>
                                <span class="status-badge" style="@GetStatusStyle(booking.Status)">
                                    @booking.Status
                                </span>
                            </div>

                            <div class="booking-content">
                                <div class="booking-header">
                                    <h3>@booking.Destination?.Name</h3>
                                    <strong class="booking-id">@booking.ConfirmationNumber</strong>
                                </div>
                                <div class="booking-details">
                                    <span class="detail"><strong>📅</strong> @(booking.StartDate.ToString("MMM dd")) - @(booking.EndDate.ToString("MMM dd, yyyy"))</span>
                                    <span class="detail"><strong>👥</strong> @booking.NumberOfTravelers</span>
                                    <span class="detail"><strong>🏙️</strong> @booking.Destination?.Province</span>
                                </div>
                                <div class="booking-price">
                                    <strong>SR @(booking.TotalPrice.ToString("N2"))</strong>
                                </div>
                            </div>

                            <div class="booking-actions">
                                <a href="/booking-confirmation/@booking.Id" class="btn-action">Details</a>
                                @* FIX: /destination/ not /destinations/ *@
                                <a href="/destination/@booking.Destination?.Id" class="btn-action">Location</a>
                                @if (booking.Status == "Confirmed" && booking.StartDate > DateTime.Now.AddDays(3))
                                {
                                    <button @onclick="() => CancelBooking(booking.Id)" class="btn-danger">Cancel</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <p>No @selectedStatus bookings found</p>
                    <a href="/planner" class="btn-primary">Plan a Trip</a>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Booking> bookings = new();
    private List<Booking> filteredBookings = new();
    private string selectedStatus = "all";
    private bool isAuthenticated = false;
    private string userId = "";
    private int upcomingCount = 0;
    private int completedCount = 0;
    private int cancelledCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        isAuthenticated = !string.IsNullOrEmpty(token);

        if (!isAuthenticated)
            return;

        // FIX: extract the actual user ID from the JWT claim instead of using the raw token string.
        // Previously: userId = token  ← WRONG — the token string is NOT a user ID.
        // The NameIdentifier claim in the JWT holds the real user ID.
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                var handler = new JwtSecurityTokenHandler();
                if (handler.CanReadToken(token))
                {
                    var jwt = handler.ReadJwtToken(token);
                    userId = jwt.Claims
                        .FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier
                                          || c.Type == "sub"
                                          || c.Type == "nameid")
                        ?.Value ?? "";
                }
            }
            catch
            {
                // Token unreadable — redirect to login
                Nav.NavigateTo("/Account/Login?returnUrl=/my-bookings");
                return;
            }
        }

        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        try
        {
            bookings = (await BookingService.GetUserBookingsAsync(userId)).ToList();
            upcomingCount  = bookings.Count(x => x.Status == "Confirmed" && x.StartDate > DateTime.Now);
            completedCount = bookings.Count(x => x.Status == "Completed");
            cancelledCount = bookings.Count(x => x.Status == "Cancelled");
            FilterByStatus("all");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading bookings: {ex.Message}");
        }
    }

    private void FilterByStatus(string status)
    {
        selectedStatus = status;
        filteredBookings = status switch
        {
            "upcoming"  => bookings.Where(x => x.Status == "Confirmed" && x.StartDate > DateTime.Now).ToList(),
            "completed" => bookings.Where(x => x.Status == "Completed").ToList(),
            "cancelled" => bookings.Where(x => x.Status == "Cancelled").ToList(),
            _           => bookings
        };
    }

    private async Task CancelBooking(int bookingId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this booking?"))
        {
            try
            {
                await BookingService.CancelAsync(bookingId);
                await LoadBookings();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cancelling booking: {ex.Message}");
            }
        }
    }

    private string GetStatusStyle(string status) => status switch
    {
        "Confirmed" => "background: #28a745; color: white;",
        "Completed" => "background: #007bff; color: white;",
        "Cancelled" => "background: #dc3545; color: white;",
        _           => "background: #ffc107; color: black;"
    };
}

<style>
    .my-bookings-page { background: #F5EFE8; min-height: 100vh; padding: 2rem 1rem; }
    .loading, .not-authenticated { display: flex; align-items: center; justify-content: center; min-height: 400px; flex-direction: column; }
    .spinner { border: 4px solid #DDD; border-top: 4px solid #8B4513; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin-bottom: 1rem; }
    @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .bookings-container { max-width: 1100px; margin: 0 auto; }
    .page-header { background: white; padding: 2rem; border-radius: 12px; margin-bottom: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .page-header h1 { margin: 0 0 0.5rem 0; color: #8B4513; }
    .filter-tabs { display: flex; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .filter-tabs button { padding: 0.75rem 1.5rem; border: 2px solid #8B4513; background: white; color: #8B4513; border-radius: 8px; cursor: pointer; font-weight: 600; transition: all 0.3s; }
    .filter-tabs button.active { background: #8B4513; color: white; }
    .bookings-list { display: flex; flex-direction: column; gap: 1.5rem; }
    .booking-card { background: white; border-radius: 12px; overflow: hidden; display: grid; grid-template-columns: 220px 1fr auto; gap: 1.5rem; align-items: center; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: transform 0.3s; }
    .booking-card:hover { transform: translateY(-3px); }
    .booking-image { position: relative; height: 150px; border-radius: 8px; overflow: hidden; }
    .booking-image img { width: 100%; height: 100%; object-fit: cover; }
    .status-badge { position: absolute; top: 10px; right: 10px; padding: 0.5rem 1rem; border-radius: 20px; font-weight: 600; font-size: 0.85rem; }
    .booking-content { display: flex; flex-direction: column; gap: 1rem; }
    .booking-header h3 { margin: 0; color: #8B4513; font-size: 1.3rem; }
    .booking-id { color: #666; font-size: 0.9rem; }
    .booking-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
    .detail { display: block; color: #666; font-size: 0.9rem; }
    .booking-price { font-size: 1.3rem; color: #8B4513; }
    .booking-actions { display: flex; flex-direction: column; gap: 0.5rem; }
    .btn-action, .btn-danger { padding: 0.5rem 1rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem; transition: all 0.3s; text-decoration: none; display: block; text-align: center; font-weight: 600; }
    .btn-action { border: 1px solid #8B4513; background: white; color: #8B4513; }
    .btn-action:hover { background: #8B4513; color: white; }
    .btn-danger { border: 1px solid #dc3545; background: white; color: #dc3545; }
    .btn-danger:hover { background: #dc3545; color: white; }
    .empty-state { background: white; padding: 3rem 2rem; border-radius: 12px; text-align: center; }
    .btn-primary { display: inline-block; padding: 0.75rem 2rem; background: #8B4513; color: white; border: none; border-radius: 8px; cursor: pointer; text-decoration: none; font-weight: 600; }
    @@media (max-width: 968px) { .booking-card { grid-template-columns: 1fr; } .booking-image { height: 200px; } }
    @@media (max-width: 600px) { .booking-details { grid-template-columns: 1fr; } }
</style>
