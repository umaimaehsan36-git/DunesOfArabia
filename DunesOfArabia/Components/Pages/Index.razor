@page "/"
@layout DunesOfArabia.Components.Layout.MainLayout
@rendermode InteractiveServer

@inject IDestinationService          DestinationService
@inject IActivityService             ActivityService
@inject IUserFavoriteService         UserFavoriteService
@inject NavigationManager            Nav
@inject AuthenticationStateProvider  AuthStateProvider

<PageTitle>Home – Saudi Heritage</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@@0,400;0,600;0,700;1,400&family=Lato:wght@@300;400;600&display=swap');

    .home-page {
        background-color: #F5EFE8;
        min-height: 100vh;
        font-family: 'Lato', sans-serif;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        overflow-y: auto;
    }

    .hero-banner {
        width: 100%;
        min-height: 220px;
        background: linear-gradient(135deg, rgba(15,8,3,0.55) 0%, rgba(90,30,15,0.70) 100%),
                    url('https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=1600') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 2rem 2.5rem;
        color: white;
        border-radius: 14px;
        gap: 2rem;
    }

    .hero-text h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(1.6rem, 2.8vw, 2.4rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .hero-text p {
        font-size: 0.88rem;
        color: rgba(255,255,255,0.78);
        line-height: 1.6;
        max-width: 460px;
        font-weight: 300;
    }

    .hero-btns {
        display: flex;
        gap: 0.75rem;
        flex-shrink: 0;
        flex-wrap: wrap;
    }

    .btn-hero-primary {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 11px 24px;
        background: #7B3121;
        color: white;
        border: none;
        border-radius: 7px;
        font-size: 0.88rem;
        font-weight: 600;
        font-family: inherit;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        white-space: nowrap;
    }

    .btn-hero-primary:hover { background: #5C2218; color: white; transform: translateY(-1px); }

    .btn-hero-outline {
        display: inline-flex;
        align-items: center;
        padding: 10px 22px;
        background: transparent;
        color: white;
        border: 1.5px solid rgba(255,255,255,0.75);
        border-radius: 7px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        font-family: inherit;
        transition: background 0.2s;
        white-space: nowrap;
    }

    .btn-hero-outline:hover { background: rgba(255,255,255,0.12); color: white; }

    .stats-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }

    .stat-card {
        background: white;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 1px 6px rgba(90,55,35,0.07);
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        background: #FAF0E8;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-text strong {
        display: block;
        font-size: 1.3rem;
        font-weight: 700;
        color: #1C1008;
        line-height: 1;
    }

    .stat-text span {
        font-size: 0.76rem;
        color: #9A8878;
        font-weight: 400;
    }

    .section-hd {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .section-hd-left h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.45rem;
        color: #1C1008;
        font-weight: 700;
        margin-bottom: 0.2rem;
    }

    .section-hd-left p {
        color: #9A8878;
        font-size: 0.82rem;
        font-weight: 300;
    }

    .btn-see-all {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.84rem;
        font-weight: 600;
        color: #7B3121;
        text-decoration: none;
        font-family: inherit;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        transition: gap 0.2s;
        white-space: nowrap;
    }

    .btn-see-all:hover { gap: 8px; color: #5C2218; }

    .dest-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .dest-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 8px rgba(90,55,35,0.07);
        transition: transform 0.22s, box-shadow 0.22s;
        display: flex;
        flex-direction: column;
    }

    .dest-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(90,55,35,0.13); }

    .dest-card-img { position: relative; }

    .dest-card-img img { width: 100%; height: 160px; object-fit: cover; display: block; }

    .dest-fav-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 30px;
        height: 30px;
        background: rgba(255,255,255,0.93);
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.85rem;
        transition: background 0.2s, transform 0.15s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    }

    .dest-fav-btn:hover { background: white; transform: scale(1.1); }

    .dest-card-body { padding: 1rem 1.1rem 1.15rem; flex: 1; display: flex; flex-direction: column; }

    .dest-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 0.2rem;
    }

    .dest-card-name {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.05rem;
        color: #1C1008;
        font-weight: 700;
        line-height: 1.2;
    }

    .dest-rating {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 0.82rem;
        font-weight: 600;
        color: #1C1008;
        white-space: nowrap;
    }

    .dest-rating .star { color: #D4A017; font-size: 0.88rem; }

    .dest-card-loc {
        font-size: 0.76rem;
        color: #9A8878;
        margin-bottom: 0.65rem;
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .dest-card-desc {
        font-size: 0.80rem;
        color: #6A5A50;
        line-height: 1.5;
        margin-bottom: 0.85rem;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-dest-explore {
        display: block;
        width: 100%;
        padding: 9px;
        text-align: center;
        font-size: 0.84rem;
        font-weight: 600;
        color: #7B3121;
        border: 1.5px solid #C8A882;
        border-radius: 7px;
        text-decoration: none;
        font-family: inherit;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

    .btn-dest-explore:hover { background: #7B3121; color: white; border-color: #7B3121; }

    .why-section {
        background: white;
        border-radius: 14px;
        padding: 1.75rem 2rem;
        box-shadow: 0 1px 8px rgba(90,55,35,0.06);
    }

    .why-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 1.25rem;
    }

    .why-card {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
    }

    .why-icon {
        width: 46px;
        height: 46px;
        background: #FAF0E8;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .why-card h4 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 0.95rem;
        color: #1C1008;
        font-weight: 700;
        margin-bottom: 0.3rem;
    }

    .why-card p {
        color: #7A6658;
        font-size: 0.80rem;
        line-height: 1.6;
        margin: 0;
    }

    .activity-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }

    .act-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 8px rgba(90,55,35,0.07);
        transition: transform 0.22s;
    }

    .act-card:hover { transform: translateY(-3px); }

    .act-card-img-wrap { position: relative; }

    .act-card-img-wrap img { width: 100%; height: 150px; object-fit: cover; display: block; }

    .act-difficulty {
        position: absolute;
        top: 8px;
        left: 8px;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.70rem;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .act-difficulty.easy     { background: #D4F5E2; color: #1A7A42; }
    .act-difficulty.moderate { background: #FFF3CC; color: #7A5A00; }
    .act-difficulty.hard     { background: #FFE0DC; color: #7A2010; }

    .act-body { padding: 0.85rem 1rem 1rem; }

    .act-name {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 0.95rem;
        color: #1C1008;
        font-weight: 700;
        margin-bottom: 0.4rem;
    }

    .act-meta {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        font-size: 0.76rem;
        color: #7A6658;
    }

    .act-meta span { display: flex; align-items: center; gap: 3px; }

    .btn-book {
        display: block;
        width: 100%;
        padding: 9px;
        background: #7B3121;
        color: white;
        border: none;
        border-radius: 7px;
        font-size: 0.84rem;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.2s;
        text-align: center;
    }

    .btn-book:hover { background: #5C2218; }

    .error-banner {
        background: #FFE0DC;
        color: #7A2010;
        border-radius: 10px;
        padding: 0.85rem 1.25rem;
        font-size: 0.86rem;
        font-weight: 600;
        text-align: center;
    }

    .cta-banner {
        background: linear-gradient(135deg, #7B3121, #9B4535);
        padding: 2rem 2.5rem;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }

    .cta-text h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        margin-bottom: 0.35rem;
    }

    .cta-text p {
        color: rgba(255,255,255,0.75);
        font-size: 0.86rem;
        font-weight: 300;
        margin: 0;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 12px 28px;
        background: white;
        color: #7B3121;
        border-radius: 7px;
        font-size: 0.90rem;
        font-weight: 700;
        text-decoration: none;
        font-family: inherit;
        transition: background 0.2s, transform 0.15s;
        border: 2px solid white;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .btn-cta:hover { background: transparent; color: white; transform: translateY(-1px); }

    .skeleton-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
    .skeleton-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }
    .skel-card { background: white; border-radius: 12px; overflow: hidden; }
    .skel-img  { width: 100%; height: 160px; background: #EEE8DF; animation: shimmer 1.4s infinite; }
    .skel-img.short { height: 150px; }
    .skel-body { padding: 0.9rem 1rem; }
    .skel-line { height: 11px; background: #EEE8DF; border-radius: 5px; margin-bottom: 8px; animation: shimmer 1.4s infinite; }
    .skel-line.short { width: 55%; }
    .skel-line.btn   { height: 33px; margin-top: 10px; }

    @@keyframes shimmer {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.5; }
    }

    @@media (max-width: 1200px) {
        .dest-grid { grid-template-columns: repeat(2,1fr); }
        .activity-grid, .skeleton-grid-4 { grid-template-columns: repeat(2,1fr); }
        .stats-bar { grid-template-columns: repeat(2,1fr); }
    }

    @@media (max-width: 900px) {
        .why-grid { grid-template-columns: 1fr; }
        .hero-banner { flex-direction: column; align-items: flex-start; min-height: auto; }
    }

    @@media (max-width: 768px) {
        .home-page { padding: 1rem; }
        .hero-banner { padding: 1.5rem; }
        .dest-grid, .skeleton-grid-3 { grid-template-columns: 1fr; }
        .activity-grid, .skeleton-grid-4 { grid-template-columns: 1fr; }
        .stats-bar { grid-template-columns: repeat(2,1fr); }
        .cta-banner { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="home-page">

    <div class="hero-banner">
        <div class="hero-text">
            <h2>Discover the Magic of<br/>Saudi Arabia</h2>
            <p>Curated travel guides, immersive cultural experiences, and unforgettable adventures across the Kingdom.</p>
        </div>
        <div class="hero-btns">
            <a href="/destinations" class="btn-hero-primary">
                Explore Destinations
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/planner" class="btn-hero-outline">Plan a Trip</a>
        </div>
    </div>

    <!-- STATS BAR — counts derived from real data fetched in OnInitializedAsync -->
    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="stat-text">
                <strong>@(isLoadingDests ? "…" : destinationCount + "+")</strong>
                <span>Destinations</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="stat-text">
                <strong>12K+</strong>
                <span>Happy Travelers</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div class="stat-text">
                <strong>@(isLoadingDests ? "…" : avgRating.ToString("0.0"))</strong>
                <span>Avg. Rating</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="stat-text">
                <strong>@(isLoadingActivities ? "…" : activityCount + "+")</strong>
                <span>Activities</span>
            </div>
        </div>
    </div>

    <!-- FEATURED DESTINATIONS -->
    <div>
        <div class="section-hd">
            <div class="section-hd-left">
                <h3>Featured Destinations</h3>
                <p>Most breathtaking locations across Saudi Arabia</p>
            </div>
            <a href="/destinations" class="btn-see-all">
                See All
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

        @if (!string.IsNullOrEmpty(destErrorMessage))
        {
            <div class="error-banner">@destErrorMessage</div>
        }
        else if (isLoadingDests)
        {
            <div class="skeleton-grid-3">
                @for (int i = 0; i < 6; i++) {
                    <div class="skel-card">
                        <div class="skel-img"></div>
                        <div class="skel-body">
                            <div class="skel-line"></div>
                            <div class="skel-line short"></div>
                            <div class="skel-line"></div>
                            <div class="skel-line btn"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dest-grid">
                @foreach (var dest in featuredDestinations)
                {
                    <div class="dest-card">
                        <div class="dest-card-img">
                            <img src="@dest.ImageUrl" alt="@dest.Name"
                                 onerror="this.src='https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600'" />
                            <button class="dest-fav-btn"
                                    @onclick="() => ToggleFavorite(dest.Id)"
                                    title="@(favIds.Contains(dest.Id) ? "Saved" : "Save")"
                                    aria-label="@(favIds.Contains(dest.Id) ? "Remove " + dest.Name + " from favourites" : "Save " + dest.Name + " to favourites")">
                                <svg width="13" height="13" viewBox="0 0 24 24"
                                     fill="@(favIds.Contains(dest.Id) ? "#7B3121" : "none")"
                                     stroke="#7B3121" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="dest-card-body">
                            <div class="dest-card-top">
                                <div class="dest-card-name">@dest.Name</div>
                                <div class="dest-rating">
                                    <span class="star">★</span>
                                    @(dest.Rating.ToString("0.0"))
                                </div>
                            </div>
                            <div class="dest-card-loc">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#9A8878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                @dest.Province
                            </div>
                            <div class="dest-card-desc">@dest.Description</div>
                            <a href="/destination/@dest.Id" class="btn-dest-explore">Explore</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- WHY CHOOSE US -->
    <div class="why-section">
        <div class="section-hd">
            <div class="section-hd-left">
                <h3>Why Choose Us</h3>
                <p>Your journey to discover Saudi Arabia starts here</p>
            </div>
        </div>
        <div class="why-grid">
            <div class="why-card">
                <div class="why-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                    <h4>Cultural Immersion</h4>
                    <p>Experience authentic Saudi culture, traditions, and hospitality with local guides who know every story.</p>
                </div>
            </div>
            <div class="why-card">
                <div class="why-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                    <h4>Expert Guides</h4>
                    <p>Journey with knowledgeable local experts who bring history and culture to life at every step.</p>
                </div>
            </div>
            <div class="why-card">
                <div class="why-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <div>
                    <h4>Curated Experiences</h4>
                    <p>Handpicked destinations and activities designed for travellers seeking genuine, unforgettable moments.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- POPULAR ACTIVITIES -->
    <div>
        <div class="section-hd">
            <div class="section-hd-left">
                <h3>Popular Activities</h3>
                <p>Unforgettable experiences await you</p>
            </div>
            <a href="/activities" class="btn-see-all">
                See All
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

        @if (!string.IsNullOrEmpty(actErrorMessage))
        {
            <div class="error-banner">@actErrorMessage</div>
        }
        else if (isLoadingActivities)
        {
            <div class="skeleton-grid-4">
                @for (int i = 0; i < 4; i++) {
                    <div class="skel-card">
                        <div class="skel-img short"></div>
                        <div class="skel-body">
                            <div class="skel-line"></div>
                            <div class="skel-line short"></div>
                            <div class="skel-line btn"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="activity-grid">
                @foreach (var act in displayActivities)
                {
                    <div class="act-card">
                        <div class="act-card-img-wrap">
                            <img src="@GetActivityImage(act.Category)" alt="@act.Name"
                                 onerror="this.src='https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=500'" />
                            <span class="act-difficulty @GetDifficultyClass(act.Category)">
                                @GetDifficultyLabel(act.Category)
                            </span>
                        </div>
                        <div class="act-body">
                            <div class="act-name">@act.Name</div>
                            <div class="act-meta">
                                <span>
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                    @act.DurationHours hrs
                                </span>
                                <span>
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                                    SAR @act.PriceSAR
                                </span>
                            </div>
                            <button class="btn-book"
                                    @onclick="() => BookActivity(act.Id)"
                                    aria-label="Book @act.Name">
                                Book Now
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- CTA BANNER -->
    <div class="cta-banner">
        <div class="cta-text">
            <h3>Ready to Start Your Adventure?</h3>
            <p>Join thousands of travelers discovering the beauty of Saudi Arabia</p>
        </div>
        <a href="/Account/Register" class="btn-cta">
            Get Started Today
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </div>

    <DunesOfArabia.Shared.Footer />
</div>

@code {
    // ── State ─────────────────────────────────────────────
    private List<Destination> featuredDestinations = new();
    private List<Activity>    displayActivities    = new();
    private HashSet<int>      favIds               = new();

    private bool    isLoadingDests      = true;
    private bool    isLoadingActivities = true;
    private string? destErrorMessage;
    private string? actErrorMessage;

    // Stats computed from fetched data (not hardcoded)
    private int    destinationCount;
    private int    activityCount;
    private double avgRating;

    // Current authenticated user id — resolved once on init
    private string? currentUserId;

    // ── Lifecycle ─────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Resolve auth state once; store userId for all service calls
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUserId = authState.User.FindFirst(
                System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }

        // Run both loads concurrently
        await Task.WhenAll(LoadDestinationsAsync(), LoadActivitiesAsync());

        // Load persisted favourites only for authenticated users
        if (currentUserId is not null)
        {
            try
            {
                var saved = await UserFavoriteService.GetUserFavoritesAsync(currentUserId);
                favIds = saved.Select(f => f.DestinationId).ToHashSet();
            }
            catch
            {
                // Non-critical — favourites display degrades gracefully
            }
        }
    }

    // ── Data loaders ──────────────────────────────────────
    private async Task LoadDestinationsAsync()
    {
        try
        {
            var all = await DestinationService.GetAllAsync();
            featuredDestinations = all.Take(6).ToList();
            destinationCount     = all.Count;
            avgRating            = all.Count > 0
                ? Math.Round(all.Average(d => d.Rating), 1)
                : 0.0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Index] Destinations error: {ex.Message}");
            destErrorMessage = "Unable to load destinations. Please refresh the page.";
        }
        finally
        {
            isLoadingDests = false;
        }
    }

    private async Task LoadActivitiesAsync()
    {
        try
        {
            var all = await ActivityService.GetAllAsync();
            displayActivities = all.Take(4).ToList();
            activityCount     = all.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Index] Activities error: {ex.Message}");
            actErrorMessage = "Unable to load activities. Please refresh the page.";
        }
        finally
        {
            isLoadingActivities = false;
        }
    }

    // ── Favourite toggle ───────────────────────────────────
    private async Task ToggleFavorite(int destinationId)
    {
        // Redirect unauthenticated users to login, preserving return URL
        if (currentUserId is null)
        {
            Nav.NavigateTo("/Account/Login?returnUrl=/", forceLoad: false);
            return;
        }

        if (favIds.Contains(destinationId))
        {
            await UserFavoriteService.RemoveFavoriteAsync(currentUserId, destinationId);
            favIds.Remove(destinationId);
        }
        else
        {
            await UserFavoriteService.AddFavoriteAsync(currentUserId, destinationId);
            favIds.Add(destinationId);
        }
    }

    // ── Book activity ─────────────────────────────────────
    private void BookActivity(int activityId)
    {
        // Redirect to activity detail/booking page
        Nav.NavigateTo("/activity/" + activityId);
    }

    // ── Helpers ───────────────────────────────────────────
    private static string GetActivityImage(string? category) => (category ?? "").ToLower() switch
    {
        "adventure" => "https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=500",
        "culture"   => "https://images.unsplash.com/photo-1539667284076-a4d98d9ac42b?w=500",
        "water"     => "https://images.unsplash.com/photo-1564769611905-cd27ee64e59b?w=500",
        "nature"    => "https://images.unsplash.com/photo-1549880338-65ddcdfd017b?w=500",
        _           => "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=500"
    };

    private static string GetDifficultyLabel(string? category) => (category ?? "").ToLower() switch
    {
        "adventure" => "Moderate",
        "water"     => "Moderate",
        "culture"   => "Easy",
        "nature"    => "Easy",
        _           => "Easy"
    };

    private static string GetDifficultyClass(string? category) => (category ?? "").ToLower() switch
    {
        "adventure" => "moderate",
        "water"     => "moderate",
        _           => "easy"
    };
}
