@code {
    /* ── State ── */
    private int              currentStep         = 1;
    private List<Destination> allDestinations    = new();

    // Step 1
    private int              selectedDestinationId = 0;
    private DateTime?        startDate             = null;
    private DateTime?        endDate               = null;
    private int              numTravelers          = 1;
    private string           tripType              = "Solo";
    private List<string>     tripTypes             = new() { "Solo", "Couple", "Family", "Group" };

    // Step 2
    private List<string> availableInterests = new()
    {
        "Heritage", "Adventure", "Food & Dining", "Shopping",
        "Nature", "Beach & Water Sports", "Desert Experiences", "Cultural Events"
    };
    private HashSet<string> selectedInterests = new();

    // Step 3
    private List<ItineraryDay> itineraryDays = new();

    /* ── Init ── */
    protected override async Task OnInitializedAsync()
    {
        try { allDestinations = await DestinationService.GetAllAsync(); }
        catch (Exception ex) { Console.WriteLine(ex); }

        BuildItineraryDays();
    }

    private void BuildItineraryDays()
    {
        var days = TripDurationDays > 0 ? TripDurationDays : 3;
        itineraryDays = Enumerable.Range(1, days).Select(d => new ItineraryDay
        {
            DayNumber = d,
            Slots = new List<ActivitySlot>
            {
                new() { Time = "09:00 AM", Label = "Morning activity slot" },
                new() { Time = "02:00 PM", Label = "Afternoon activity slot" }
            }
        }).ToList();
    }

    /* ── Navigation ── */
    private void GoNext()
    {
        if (currentStep == 1) BuildItineraryDays();
        if (currentStep < 4) currentStep++;
    }

    private void GoBack()
    {
        if (currentStep > 1) currentStep--;
    }

    private void Complete() => Nav.NavigateTo("/itinerary");

    /* ── Step 1 helpers ── */
    private void IncrementTravelers() { if (numTravelers < 20) numTravelers++; }
    private void DecrementTravelers() { if (numTravelers > 1)  numTravelers--; }

    /* ── Step 2 helpers ── */
    private void ToggleInterest(string item)
    {
        if (selectedInterests.Contains(item)) selectedInterests.Remove(item);
        else                                  selectedInterests.Add(item);
    }

    /* ── Step 3 helpers ── */
    private void AddActivitySlot(int dayNum)
    {
        var day = itineraryDays.FirstOrDefault(d => d.DayNumber == dayNum);
        if (day == null) return;
        var nextHour = 9 + day.Slots.Count * 3;
        var ampm     = nextHour >= 12 ? "PM" : "AM";
        var hour     = nextHour > 12 ? nextHour - 12 : nextHour;
        day.Slots.Add(new ActivitySlot { Time = $"{hour:D2}:00 {ampm}", Label = "New activity slot" });
    }

    /* ── Summary helpers ── */
    private string? GetDestinationName()
        => allDestinations.FirstOrDefault(d => d.Id == selectedDestinationId)?.Name;

    private int TripDurationDays
        => (startDate.HasValue && endDate.HasValue && endDate > startDate)
            ? (int)(endDate.Value - startDate.Value).TotalDays
            : 0;

    private string EstimatedCostRange
    {
        get
        {
            var base1 = numTravelers * 300 + TripDurationDays * 150;
            var base2 = numTravelers * 500 + TripDurationDays * 250;
            if (base1 == 0) return "$1,200 – $2,000";
            return $"${base1:N0} – ${base2:N0}";
        }
    }

    private async Task SaveItinerary()
    {
        // Persist logic via IItineraryService if available
        try
        {
            if (ItineraryService != null)
            {
                var plan = new Itinerary
                {
                    DestinationId = selectedDestinationId,
                    StartDate     = startDate ?? DateTime.Today,
                    EndDate       = endDate   ?? DateTime.Today.AddDays(3),
                    Travelers     = numTravelers,
                    TripType      = tripType,
                    Interests = selectedInterests.ToList()
                };
                await ItineraryService.SaveAsync(plan);
            }
        }
        catch (Exception ex) { Console.WriteLine(ex); }

        Nav.NavigateTo("/itinerary");
    }

    private void ShareItinerary()
    {
        // Placeholder – could open a share modal
    }

    /* ── Inner models ── */
    private class ItineraryDay
    {
        public int                DayNumber { get; set; }
        public List<ActivitySlot> Slots     { get; set; } = new();
    }

    private class ActivitySlot
    {
        public string Time  { get; set; } = "";
        public string Label { get; set; } = "";
    }
