@inherits LayoutComponentBase

@* FIX 9: MainLayout was referenced in NotFound.razor as @layout MainLayout
   but the namespace wasn't resolvable there. The root _Imports.razor fix
   (adding @using DunesOfArabia.Components.Layout) resolves this globally.
   MainLayout itself is correct — no logic changes needed here. *@

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <LoginDisplay />
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
