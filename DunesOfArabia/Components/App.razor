@* FIX 4: Added @using Microsoft.AspNetCore.Components.Web at the top of App.razor
   as a safety net. App.razor sits outside the normal _Imports.razor cascade in some
   project structures, so HeadOutlet (which lives in that namespace) wasn't resolving,
   giving: "Found markup element with unexpected name 'HeadOutlet'" *@
@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/saudi-theme.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
