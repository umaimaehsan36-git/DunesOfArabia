@page "/destinations"
@using DunesOfArabia.Models
@using DunesOfArabia.Data
@inject AppDbContext DbContext

<PageTitle>Destinations – Saudi Heritage</PageTitle>

<style>
    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .dest-page {
        background-color: #EDE8DF;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding-bottom: 4rem;
    }

    .page-header {
        padding: 3rem 2.5rem 2rem;
        max-width: 1260px;
        margin: 0 auto;
    }

    .page-header h1 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 2.6rem;
        color: #2E1A0E;
        font-weight: 700;
        margin-bottom: 0.4rem;
    }

    .page-header p {
        font-size: 0.95rem;
        color: #7A6658;
    }

    .search-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        max-width: 1260px;
        margin: 0 auto 1.2rem;
        padding: 0 2.5rem;
    }

    .search-wrap {
        flex: 1;
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9A8878;
        display: flex;
        align-items: center;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        padding: 11px 16px 11px 42px;
        border: 1.5px solid #D5C9BC;
        border-radius: 8px;
        font-size: 0.92rem;
        font-family: inherit;
        background: white;
        color: #2E1A0E;
        outline: none;
        transition: border-color 0.2s;
    }

    .search-input::placeholder { color: #B0A090; }
    .search-input:focus { border-color: #7B3121; }

    .sort-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        background: white;
        border: 1.5px solid #D5C9BC;
        border-radius: 8px;
        padding: 10px 14px;
        white-space: nowrap;
        transition: border-color 0.2s;
    }

    .sort-wrap:focus-within { border-color: #7B3121; }
    .sort-wrap svg { color: #7A6658; flex-shrink: 0; }

    .sort-select {
        border: none;
        outline: none;
        font-size: 0.88rem;
        font-family: inherit;
        color: #2E1A0E;
        background: transparent;
        cursor: pointer;
        padding-right: 4px;
    }

    .filter-row {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        max-width: 1260px;
        margin: 0 auto 2rem;
        padding: 0 2.5rem;
    }

    .filter-btn {
        padding: 8px 20px;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
        border: 1.5px solid #C4A090;
        background: transparent;
        color: #5A3A2A;
    }

    .filter-btn:hover { border-color: #7B3121; color: #7B3121; }
    .filter-btn.active { background: #7B3121; border-color: #7B3121; color: white; }

    .destinations-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.6rem;
        max-width: 1260px;
        margin: 0 auto;
        padding: 0 2.5rem;
    }

    .dest-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(90,55,35,0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .dest-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(90,55,35,0.14);
    }

    .card-img-wrap { position: relative; }

    .card-img-wrap img {
        width: 100%;
        height: 210px;
        object-fit: cover;
        display: block;
    }

    .bookmark-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        background: white;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.14);
        transition: background 0.2s;
    }

    .bookmark-btn:hover { background: #f5f0eb; }

    .card-body { padding: 1.2rem 1.3rem 1.4rem; }

    .card-name-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.35rem;
    }

    .card-name {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1.2rem;
        color: #2E1A0E;
        font-weight: 700;
    }

    .card-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.88rem;
        color: #2E1A0E;
        font-weight: 600;
    }

    .star { color: #C8873A; }

    .card-location {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #7A6658;
        font-size: 0.82rem;
        margin-bottom: 0.65rem;
    }

    .card-desc {
        color: #5A4A3A;
        font-size: 0.86rem;
        line-height: 1.55;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-explore {
        display: block;
        width: 100%;
        padding: 10px;
        background: transparent;
        color: #7B3121;
        border: 1.5px solid #C4A090;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
    }

    .btn-explore:hover { background: #7B3121; border-color: #7B3121; color: white; }

    .results-count {
        text-align: center;
        color: #7A6658;
        font-size: 0.875rem;
        margin-top: 2.2rem;
        padding: 0 2.5rem;
    }

    .no-results {
        grid-column: 1 / -1;
        text-align: center;
        padding: 4rem 2rem;
        color: #7A6658;
    }

    .no-results h3 {
        font-family: Georgia, serif;
        color: #2E1A0E;
        margin-bottom: 0.5rem;
        font-size: 1.3rem;
    }

    /* FOOTER */
    .footer {
        background-color: #7B3121;
        color: white;
        padding: 3.5rem 2.5rem 1.5rem;
        margin-top: 4rem;
    }

    .footer-inner { max-width: 1260px; margin: 0 auto; }

    .footer-cols {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr 1fr;
        gap: 3rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.18);
        margin-bottom: 1.5rem;
    }

    .footer-brand h4 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 1rem;
    }

    .footer-brand p { font-size: 0.84rem; color: rgba(255,255,255,0.70); line-height: 1.65; }
    .footer-col h5 { font-size: 0.875rem; font-weight: 700; margin-bottom: 1rem; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
    .footer-col ul li a { font-size: 0.84rem; color: rgba(255,255,255,0.70); text-decoration: none; transition: color 0.2s; }
    .footer-col ul li a:hover { color: white; }
    .footer-bottom { display: flex; align-items: center; justify-content: space-between; }
    .footer-bottom p { font-size: 0.82rem; color: rgba(255,255,255,0.55); }
    .footer-socials { display: flex; gap: 1.2rem; align-items: center; }
    .footer-socials a { color: rgba(255,255,255,0.70); text-decoration: none; transition: color 0.2s; display: flex; align-items: center; }
    .footer-socials a:hover { color: white; }

    @@media (max-width: 1024px) {
        .destinations-grid { grid-template-columns: repeat(2, 1fr); }
        .footer-cols { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 640px) {
        .destinations-grid { grid-template-columns: 1fr; }
        .search-row { flex-direction: column; }
        .footer-cols { grid-template-columns: 1fr; }
        .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
        .page-header h1 { font-size: 2rem; }
    }
</style>

<div class="dest-page">

    <div class="page-header">
        <h1>Explore Saudi Arabia</h1>
        <p>Discover breathtaking destinations across the Kingdom</p>
    </div>

    <!-- SEARCH + SORT -->
    <div class="search-row">
        <div class="search-wrap">
            <span class="search-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
                </svg>
            </span>
            <input class="search-input"
                   type="text"
                   placeholder="Search destinations..."
                   @bind="searchQuery"
                   @bind:event="oninput" />
        </div>
        <div class="sort-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="21" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/>
                <line x1="21" y1="14" x2="3" y2="14"/><line x1="21" y1="18" x2="3" y2="18"/>
            </svg>
            <select class="sort-select" @bind="sortOrder">
                <option value="popular">Most Popular</option>
                <option value="rating_desc">Highest Rated</option>
                <option value="name_asc">Name A–Z</option>
                <option value="name_desc">Name Z–A</option>
            </select>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </div>
    </div>

    <!-- CATEGORY FILTER BUTTONS -->
    <div class="filter-row">
        <button class="filter-btn @(selectedCategory == "" ? "active" : "")"
                @onclick="@(() => SetCategory(""))">All</button>
        <button class="filter-btn @(selectedCategory == "Historical" ? "active" : "")"
                @onclick="@(() => SetCategory("Historical"))">Historical</button>
        <button class="filter-btn @(selectedCategory == "Nature" ? "active" : "")"
                @onclick="@(() => SetCategory("Nature"))">Nature</button>
        <button class="filter-btn @(selectedCategory == "Coastal" ? "active" : "")"
                @onclick="@(() => SetCategory("Coastal"))">Coastal</button>
        <button class="filter-btn @(selectedCategory == "Desert" ? "active" : "")"
                @onclick="@(() => SetCategory("Desert"))">Desert</button>
    </div>

    <!-- GRID -->
    <div class="destinations-grid">
        @if (!DisplayedDestinations.Any())
        {
            <div class="no-results">
                <h3>No destinations found</h3>
                <p>Try adjusting your search or filters.</p>
            </div>
        }
        else
        {
            @foreach (var dest in DisplayedDestinations)
            {
                <div class="dest-card">
                    <div class="card-img-wrap">
                        <img src="@dest.ImageUrl" alt="@dest.Name" />
                        <button class="bookmark-btn" aria-label="Save @dest.Name">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#7A6658" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="card-name-row">
                            <span class="card-name">@dest.Name</span>
                            <span class="card-rating">
                                <span class="star">★</span> @dest.Rating.ToString("0.0")
                            </span>
                        </div>
                        <div class="card-location">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            @dest.Province
                        </div>
                        <p class="card-desc">@dest.Description</p>
                        <a href="/destinations/@dest.Id" class="btn-explore">Explore</a>
                    </div>
                </div>
            }
        }
    </div>

    <p class="results-count">Showing @DisplayedDestinations.Count() of @allDestinations.Count destinations</p>

</div>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-cols">
            <div class="footer-brand">
                <h4>SAUDI HERITAGE</h4>
                <p>Experience the magic of Saudi Arabia with curated travel guides and unforgettable adventures.</p>
            </div>
            <div class="footer-col">
                <h5>Explore</h5>
                <ul>
                    <li><a href="/destinations">Destinations</a></li>
                    <li><a href="/activities">Activities</a></li>
                    <li><a href="/map">Map</a></li>
                    <li><a href="/planner">Trip Planner</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Company</h5>
                <ul>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/careers">Careers</a></li>
                    <li><a href="/press">Press</a></li>
                    <li><a href="/blog">Blog</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h5>Support</h5>
                <ul>
                    <li><a href="/help">Help Center</a></li>
                    <li><a href="/safety">Safety</a></li>
                    <li><a href="/terms">Terms of Service</a></li>
                    <li><a href="/privacy">Privacy Policy</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 Saudi Heritage. All rights reserved.</p>
            <div class="footer-socials">
                <a href="#" aria-label="Facebook">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
                <a href="#" aria-label="Instagram">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                </a>
                <a href="#" aria-label="Twitter">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
                </a>
                <a href="#" aria-label="Email">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </a>
            </div>
        </div>
    </div>
</footer>

@code {
    // Local view model — independent of DB schema so Rating/ImageUrl don't need to exist on the model
    private class DestCard
    {
        public int    Id          { get; set; }
        public string Name        { get; set; } = "";
        public string Province    { get; set; } = "";
        public string Category    { get; set; } = "";
        public string Description { get; set; } = "";
        public double Rating      { get; set; }
        public string ImageUrl    { get; set; } = "";
    }

    private List<DestCard> allDestinations = new();
    private string searchQuery      = "";
    private string selectedCategory = "";
    private string sortOrder        = "popular";

    // Explicit method so Blazor StateHasChanged fires correctly
    private void SetCategory(string cat)
    {
        selectedCategory = cat;
    }

    private IEnumerable<DestCard> FilteredDestinations =>
        allDestinations
            .Where(d => string.IsNullOrEmpty(searchQuery) ||
                        d.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        d.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .Where(d => string.IsNullOrEmpty(selectedCategory) ||
                        d.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DestCard> DisplayedDestinations => sortOrder switch
    {
        "rating_desc" => FilteredDestinations.OrderByDescending(d => d.Rating),
        "name_asc"    => FilteredDestinations.OrderBy(d => d.Name),
        "name_desc"   => FilteredDestinations.OrderByDescending(d => d.Name),
        _             => FilteredDestinations
    };

    protected override async Task OnInitializedAsync()
    {
        var dbDests = DbContext.Destinations.ToList();

        if (dbDests.Any())
        {
            allDestinations = dbDests.Select(d => new DestCard
            {
                Id          = d.Id,
                Name        = d.Name,
                Province    = d.Province,
                Category    = d.Category,
                Description = d.Description,
                Rating      = GetRating(d.Name),
                ImageUrl    = GetImage(d.Name)
            }).ToList();
        }
        else
        {
            // Always show 9 cards even when DB is empty
            allDestinations = GetDemoDestinations();
        }
    }

    private double GetRating(string name) => name switch
    {
        "Riyadh"          => 4.8,
        "AlUla"           => 4.9,
        "Jeddah"          => 4.7,
        "Diriyah"         => 4.6,
        "Empty Quarter"   => 4.5,
        "Asir Mountains"  => 4.7,
        "Taif"            => 4.4,
        "Red Sea Project" => 4.8,
        "Al-Ahsa Oasis"   => 4.3,
        _                 => 4.5
    };

    private string GetImage(string name) => name switch
    {
        "Riyadh"          => "https://images.unsplash.com/photo-1586724237569-f3d0c1dee8c6?w=600",
        "AlUla"           => "https://images.unsplash.com/photo-1565942808745-18e90a8c4872?w=600",
        "Jeddah"          => "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600",
        "Diriyah"         => "https://images.unsplash.com/photo-1578895101408-1a36b834405b?w=600",
        "Empty Quarter"   => "https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=600",
        "Asir Mountains"  => "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600",
        "Taif"            => "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600",
        "Red Sea Project" => "https://images.unsplash.com/photo-1539667284076-a4d98d9ac42b?w=600",
        "Al-Ahsa Oasis"   => "https://images.unsplash.com/photo-1549880338-65ddcdfd017b?w=600",
        _                 => "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600"
    };

    private List<DestCard> GetDemoDestinations() => new()
    {
        new() { Id=1, Name="Riyadh",          Province="Central Region",            Category="Urban",      Rating=4.8, Description="The modern capital blending innovation with rich cultural heritage and historic landmarks.",               ImageUrl=GetImage("Riyadh") },
        new() { Id=2, Name="AlUla",            Province="Northwestern Saudi Arabia", Category="Historical", Rating=4.9, Description="Ancient rock formations and UNESCO World Heritage sites in a stunning desert landscape.",               ImageUrl=GetImage("AlUla") },
        new() { Id=3, Name="Jeddah",           Province="Red Sea Coast",             Category="Coastal",    Rating=4.7, Description="Historic port city with beautiful coastline, vibrant culture, and world-class diving.",                 ImageUrl=GetImage("Jeddah") },
        new() { Id=4, Name="Diriyah",          Province="Riyadh Province",           Category="Historical", Rating=4.6, Description="The birthplace of the Kingdom with beautifully preserved mud-brick architecture.",                      ImageUrl=GetImage("Diriyah") },
        new() { Id=5, Name="Empty Quarter",    Province="Southern Saudi Arabia",     Category="Desert",     Rating=4.5, Description="The world's largest continuous sand desert offering unparalleled adventure experiences.",                ImageUrl=GetImage("Empty Quarter") },
        new() { Id=6, Name="Asir Mountains",   Province="Southwestern Saudi Arabia", Category="Nature",     Rating=4.7, Description="Lush green mountains with cooler climate and breathtaking natural landscapes.",                         ImageUrl=GetImage("Asir Mountains") },
        new() { Id=7, Name="Taif",             Province="Makkah Province",           Category="Nature",     Rating=4.4, Description="Mountain resort city famous for its rose gardens and pleasant summer weather.",                         ImageUrl=GetImage("Taif") },
        new() { Id=8, Name="Red Sea Project",  Province="Western Coast",             Category="Coastal",    Rating=4.8, Description="Pristine islands and turquoise waters perfect for luxury beach getaways.",                              ImageUrl=GetImage("Red Sea Project") },
        new() { Id=9, Name="Al-Ahsa Oasis",    Province="Eastern Province",          Category="Nature",     Rating=4.3, Description="The world's largest oasis with date palm gardens and natural springs.",                                ImageUrl=GetImage("Al-Ahsa Oasis") },
    };
}
