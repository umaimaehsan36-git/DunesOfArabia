@page "/destinations"
@using DunesOfArabia.Models
@using DunesOfArabia.Data
@inject AppDbContext DbContext

<PageTitle>Destinations – Saudi Heritage</PageTitle>

<style>
    .destinations-page {
        background-color: #F5F1E8;
        min-height: 100vh;
        padding: 2rem;
    }

    .page-header {
        text-align: center;
        padding: 2rem 0 3rem 0;
    }

    .page-header h1 {
        font-family: Georgia, serif;
        color: #5C3D2E;
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .page-header p {
        color: #8a7060;
        font-size: 1.1rem;
    }

    .filters {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .filter-input {
        padding: 10px 16px;
        border: 2px solid #E8DCC8;
        border-radius: 4px;
        font-size: 1rem;
        font-family: inherit;
        background: white;
        color: #333;
        min-width: 200px;
    }

    .filter-input:focus {
        outline: none;
        border-color: #8B5A3C;
    }

    .filter-btn {
        padding: 10px 20px;
        border: 2px solid #8B5A3C;
        border-radius: 4px;
        background: transparent;
        color: #8B5A3C;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.3s;
    }

    .filter-btn:hover, .filter-btn.active {
        background-color: #8B5A3C;
        color: white;
    }

    .results-count {
        text-align: center;
        color: #8a7060;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
    }

    .destinations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .destination-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .destination-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }

    .destination-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .card-body {
        padding: 1.5rem;
    }

    .badge-row {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-category {
        background-color: #8B5A3C;
        color: white;
    }

    .badge-province {
        background-color: #F5F1E8;
        color: #5C3D2E;
        border: 1px solid #E8DCC8;
    }

    .card-title {
        font-family: Georgia, serif;
        color: #5C3D2E;
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
    }

    .card-meta {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
        color: #8a7060;
        margin-bottom: 0.75rem;
    }

    .card-description {
        color: #666;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 1rem;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-cost {
        color: #5C3D2E;
        font-weight: 700;
        font-size: 1rem;
    }

    .btn-details {
        background-color: transparent;
        color: #8B5A3C;
        border: 2px solid #8B5A3C;
        padding: 7px 18px;
        border-radius: 4px;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.3s;
        display: inline-block;
    }

    .btn-details:hover {
        background-color: #8B5A3C;
        color: white;
    }

    .no-results {
        text-align: center;
        padding: 4rem;
        color: #8a7060;
        grid-column: 1 / -1;
    }

    .no-results h3 {
        font-family: Georgia, serif;
        color: #5C3D2E;
        margin-bottom: 0.5rem;
    }
</style>

<div class="destinations-page">
    <div class="page-header">
        <h1>Explore Saudi Arabia</h1>
        <p>Discover breathtaking destinations across the Kingdom</p>
    </div>

    <!-- FILTERS -->
    <div class="filters">
        <input class="filter-input"
               type="text"
               placeholder="🔍 Search destinations..."
               @bind="searchQuery"
               @bind:event="oninput" />

        <select class="filter-input" @bind="selectedProvince">
            <option value="">All Provinces</option>
            @foreach (var province in provinces)
            {
                <option value="@province">@province</option>
            }
        </select>

        <select class="filter-input" @bind="selectedCategory">
            <option value="">All Categories</option>
            <option value="Historical">Historical</option>
            <option value="Nature">Nature</option>
            <option value="Coastal">Coastal</option>
            <option value="Urban">Urban</option>
        </select>

        <button class="filter-btn" @onclick="ClearFilters">Clear Filters</button>
    </div>

    <p class="results-count">Showing @FilteredDestinations.Count() destination(s)</p>

    <!-- GRID -->
    <div class="destinations-grid">
        @if (!FilteredDestinations.Any())
        {
            <div class="no-results">
                <h3>No destinations found</h3>
                <p>Try adjusting your search or filters.</p>
            </div>
        }
        else
        {
            @foreach (var dest in FilteredDestinations)
            {
                <div class="destination-card">
                    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400"
                         alt="@dest.Name" />
                    <div class="card-body">
                        <div class="badge-row">
                            <span class="badge badge-category">@dest.Category.ToUpper()</span>
                            <span class="badge badge-province">@dest.Province</span>
                        </div>
                        <h3 class="card-title">@dest.Name</h3>
                        <div class="card-meta">
                            <span>🌤️ @dest.Climate</span>
                            <span>🛂 @dest.VisaInfo</span>
                        </div>
                        <p class="card-description">@dest.Description</p>
                        <div class="card-footer">
                            <span class="card-cost">SAR @dest.Cost / day</span>
                            <a href="/destinations/@dest.Id" class="btn-details">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<Destination> allDestinations = new();
    private string searchQuery = "";
    private string selectedProvince = "";
    private string selectedCategory = "";

    private IEnumerable<string> provinces =>
        allDestinations.Select(d => d.Province).Distinct().OrderBy(p => p);

    private IEnumerable<Destination> FilteredDestinations =>
        allDestinations
            .Where(d => string.IsNullOrEmpty(searchQuery) ||
                        d.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        d.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .Where(d => string.IsNullOrEmpty(selectedProvince) || d.Province == selectedProvince)
            .Where(d => string.IsNullOrEmpty(selectedCategory) || d.Category == selectedCategory);

    protected override async Task OnInitializedAsync()
    {
        allDestinations = DbContext.Destinations.ToList();
    }

    private void ClearFilters()
    {
        searchQuery = "";
        selectedProvince = "";
        selectedCategory = "";
    }
}