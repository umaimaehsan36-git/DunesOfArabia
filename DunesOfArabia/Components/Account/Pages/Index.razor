<!-- ── POPULAR ACTIVITIES ── -->
<section class="activities-section">
    <h2 class="section-title">Popular Activities</h2>
    <p class="section-subtitle">Unforgettable experiences await you</p>

    <div class="activities-grid" style="margin-top: 2.5rem;">
        <!-- Desert Safari -->
        <div class="activity-card">
            <div class="activity-img-wrap">
                <img src="https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=500" alt="Desert Safari" />
                <span class="difficulty-badge badge-moderate">Moderate</span>
            </div>
            <div class="activity-body">
                <h3 class="activity-name">Desert Safari</h3>
                <div class="activity-meta">
                    <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
