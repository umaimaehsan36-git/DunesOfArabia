@page "/"
@using DunesOfArabia.Models

<style>
    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body, html {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* ── HERO ── */
    .hero-section {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background-image: url('https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=1600');
        background-size: cover;
        background-position: center;
        filter: brightness(0.55);
        z-index: 0;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        max-width: 780px;
        padding: 2rem;
        color: white;
    }

    .hero-content h1 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 3.2rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1.25rem;
        letter-spacing: 0.3px;
    }

    .hero-content p {
        font-size: 1.1rem;
        line-height: 1.8;
        color: rgba(255,255,255,0.88);
        margin-bottom: 2.2rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-hero-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 32px;
        background-color: #7B3121;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.15s ease;
        letter-spacing: 0.3px;
    }

    .btn-hero-primary:hover {
        background-color: #5C2218;
        transform: translateY(-1px);
        color: white;
    }

    .btn-hero-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 32px;
        background-color: transparent;
        color: white;
        border: 2px solid white;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .btn-hero-secondary:hover {
        background-color: white;
        color: #7B3121;
    }

    /* ── FEATURED DESTINATIONS ── */
    .featured-section {
        background-color: #EDE8DF;
        padding: 5rem 2rem;
        text-align: center;
    }

    .section-title {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 2.1rem;
        color: #2E1A0E;
        font-weight: 700;
        margin-bottom: 0.6rem;
    }

    .section-subtitle {
        font-size: 0.95rem;
        color: #7A6658;
        margin-bottom: 2.8rem;
    }

    .dest-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.4rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .dest-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(90,55,35,0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        text-align: left;
    }

    .dest-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(90,55,35,0.16);
    }

    .dest-card-img-wrap {
        position: relative;
    }

    .dest-card-img-wrap img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    .bookmark-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        background: white;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        transition: background 0.2s;
    }

    .bookmark-btn:hover {
        background: #f5f0eb;
    }

    .dest-card-body {
        padding: 1.1rem 1.2rem 1.3rem;
    }

    .dest-card-name-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.35rem;
    }

    .dest-card-name {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1.15rem;
        color: #2E1A0E;
        font-weight: 700;
    }

    .dest-card-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.88rem;
        color: #2E1A0E;
        font-weight: 600;
    }

    .star-icon {
        color: #C8873A;
        font-size: 0.95rem;
    }

    .dest-card-location {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #7A6658;
        font-size: 0.82rem;
        margin-bottom: 0.65rem;
    }

    .dest-card-desc {
        color: #5A4A3A;
        font-size: 0.85rem;
        line-height: 1.55;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-explore {
        display: block;
        width: 100%;
        padding: 10px;
        background: transparent;
        color: #7B3121;
        border: 1.5px solid #C4A090;
        border-radius: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
    }

    .btn-explore:hover {
        background: #7B3121;
        border-color: #7B3121;
        color: white;
    }

    /* ── WHY CHOOSE US ── */
    .why-section {
        background: white;
        padding: 5rem 2rem;
        text-align: center;
    }

    .why-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3rem;
        max-width: 860px;
        margin: 3rem auto 0;
    }

    .why-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.9rem;
    }

    .why-icon-wrap {
        width: 64px;
        height: 64px;
        background: #FAF0E6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .why-icon-wrap svg {
        color: #C8873A;
    }

    .why-item h3 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1rem;
        color: #2E1A0E;
        font-weight: 700;
    }

    .why-item p {
        color: #7A6658;
        font-size: 0.88rem;
        line-height: 1.6;
        max-width: 220px;
    }

    /* ── POPULAR ACTIVITIES ── */
    .activities-section {
        background-color: #EDE8DF;
        padding: 5rem 2rem;
        text-align: center;
    }

    .activities-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.4rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .activity-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(90,55,35,0.08);
        text-align: left;
        transition: transform 0.25s ease;
    }

    .activity-card:hover {
        transform: translateY(-3px);
    }

    .activity-img-wrap {
        position: relative;
    }

    .activity-img-wrap img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    .difficulty-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-easy {
        background: #D4EDDA;
        color: #2A6B3A;
    }

    .badge-moderate {
        background: #FFF3CD;
        color: #7B5E00;
    }

    .activity-body {
        padding: 1.1rem 1.2rem 1.3rem;
    }

    .activity-name {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1.1rem;
        color: #2E1A0E;
        font-weight: 700;
        margin-bottom: 0.6rem;
    }

    .activity-meta {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .activity-meta span {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.82rem;
        color: #7A6658;
    }

    .btn-book {
        display: block;
        width: 100%;
        padding: 11px;
        background: #7B3121;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-book:hover {
        background: #5C2218;
    }

    /* ── CTA BANNER ── */
    .cta-section {
        background-color: #7B3121;
        padding: 4.5rem 2rem;
        text-align: center;
    }

    .cta-section h2 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 2rem;
        color: white;
        font-weight: 700;
        margin-bottom: 0.7rem;
    }

    .cta-section p {
        color: rgba(255,255,255,0.82);
        font-size: 1rem;
        margin-bottom: 2rem;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 36px;
        background: transparent;
        color: #7B3121;
        border: 2px solid white;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.2s;
        background: white;
    }

    .btn-cta:hover {
        background: rgba(255,255,255,0.88);
        color: #7B3121;
    }

    /* ── FOOTER ── */
    .footer-top {
        background-color: #EDE8DF;
        height: 28px;
    }

    .footer {
        background-color: #7B3121;
        color: white;
        padding: 3.5rem 2rem 1.5rem;
    }

    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
    }

    .footer-cols {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr 1fr;
        gap: 3rem;
        padding-bottom: 2.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.18);
        margin-bottom: 1.5rem;
    }

    .footer-brand h4 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 1rem;
        color: white;
    }

    .footer-brand p {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.72);
        line-height: 1.65;
    }

    .footer-col h5 {
        font-size: 0.88rem;
        font-weight: 700;
        color: white;
        margin-bottom: 1rem;
        letter-spacing: 0.3px;
    }

    .footer-col ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .footer-col ul li a {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.72);
        text-decoration: none;
        transition: color 0.2s;
    }

    .footer-col ul li a:hover {
        color: white;
    }

    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .footer-bottom p {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.60);
    }

    .footer-socials {
        display: flex;
        gap: 1.2rem;
        align-items: center;
    }

    .footer-socials a {
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        transition: color 0.2s;
        display: flex;
        align-items: center;
    }

    .footer-socials a:hover {
        color: white;
    }

    @@media (max-width: 1024px) {
        .dest-grid, .activities-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .footer-cols {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 640px) {
        .dest-grid, .activities-grid, .why-grid {
            grid-template-columns: 1fr;
        }
        .hero-content h1 {
            font-size: 2.2rem;
        }
        .footer-cols {
            grid-template-columns: 1fr;
        }
        .footer-bottom {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
    }
</style>

<!-- ── HERO ── -->
<section class="hero-section">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <h1>Discover the Magic of Saudi Arabia</h1>
