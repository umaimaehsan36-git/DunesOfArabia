@* _Imports.razor
   Place at: DunesOfArabia/Components/Account/_Imports.razor

   This makes StatusMessage, ExternalLoginPicker, LoginDisplay, and
   RedirectToLogin available to every page inside the Account folder
   without needing a @using on each individual page.
   
   This is why you were getting:
   "Found markup element with unexpected name 'StatusMessage'"
   "Found markup element with unexpected name 'ExternalLoginPicker'"
   — those components existed nowhere AND weren't imported. *@
@using DunesOfArabia.Services
@using DunesOfArabia.Models
@using DunesOfArabia.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using DunesOfArabia.Components.Account.Shared
@layout DunesOfArabia.Components.Layout.AccountLayout