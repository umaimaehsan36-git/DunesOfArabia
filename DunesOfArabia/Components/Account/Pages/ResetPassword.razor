@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using DunesOfArabia.Data

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Reset Password – Dunes Of Arabia</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap');
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .auth-page {
        min-height: 100vh;
        background: radial-gradient(ellipse at 60% 40%, #E8D9C5 0%, #DFD0B8 50%, #D4C4A8 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .auth-brand { text-align: center; margin-bottom: 2rem; }
    .auth-brand h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 2.6rem;
        font-weight: 700;
        color: #7B2D10;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }
    .auth-brand p { font-size: 1rem; color: #8B6650; }

    .auth-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 3rem 3rem 2.5rem;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 4px 40px rgba(100, 50, 20, 0.10);
    }

    .card-icon { text-align: center; font-size: 3rem; margin-bottom: 1rem; }

    .card-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.85rem;
        font-weight: 600;
        color: #1C0F07;
        text-align: center;
        margin-bottom: 0.75rem;
    }

    .card-subtitle {
        font-size: 0.9rem;
        color: #8B6650;
        text-align: center;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .alert-error {
        background-color: #FEF2F2;
        color: #991B1B;
        border: 1px solid #FCA5A5;
        border-radius: 8px;
        padding: 0.85rem 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }

    .form-group { margin-bottom: 1.6rem; }
    .form-label { display: block; font-size: 0.95rem; font-weight: 600; color: #1C0F07; margin-bottom: 0.6rem; }

    .input-wrapper { position: relative; display: flex; align-items: center; }
    .input-icon { position: absolute; left: 14px; font-size: 1rem; color: #8B6650; pointer-events: none; line-height: 1; }

    .form-input {
        width: 100%;
        padding: 13px 14px 13px 42px;
        border: 1.5px solid #E5D8C8;
        border-radius: 8px;
        font-size: 0.95rem;
        font-family: inherit;
        color: #1C0F07;
        background-color: #FDFAF7;
        transition: border-color 0.25s, box-shadow 0.25s;
        appearance: none;
    }
    .form-input:focus { outline: none; border-color: #8B5A3C; background-color: #FFFFFF; box-shadow: 0 0 0 3px rgba(139, 90, 60, 0.12); }
    .form-input::placeholder { color: #BBA898; font-weight: 300; }

    /* Strength meter */
    .strength-bar-wrap { display: flex; gap: 4px; margin-top: 8px; }
    .strength-seg { flex: 1; height: 4px; border-radius: 2px; background: #E5D8C8; transition: background 0.3s; }
    .strength-label { font-size: 0.75rem; margin-top: 4px; font-weight: 500; transition: color 0.3s; color: #BBA898; }
    .str-1 .strength-seg:nth-child(1) { background: #DC2626; }
    .str-2 .strength-seg:nth-child(-n+2) { background: #F59E0B; }
    .str-3 .strength-seg:nth-child(-n+3) { background: #10B981; }
    .str-4 .strength-seg { background: #059669; }

    .validation-error { color: #DC2626; font-size: 0.78rem; margin-top: 0.4rem; display: block; }

    .btn-primary {
        width: 100%;
        padding: 15px;
        background-color: #7B2D10;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        letter-spacing: 0.5px;
        transition: background-color 0.25s, transform 0.2s, box-shadow 0.25s;
        margin-bottom: 0.5rem;
    }
    .btn-primary:hover { background-color: #5C2009; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(123, 45, 16, 0.35); }
    .btn-primary:active { transform: translateY(0); }

    .card-footer-text {
        text-align: center;
        font-size: 0.9rem;
        color: #8B6650;
        padding-top: 1.4rem;
        border-top: 1px solid #F0E6D8;
        margin-top: 1.4rem;
    }
    .card-footer-text a { color: #1C0F07; font-weight: 700; text-decoration: none; }
    .card-footer-text a:hover { color: #7B2D10; text-decoration: underline; }

    @@media (max-width: 600px) {
        .auth-card { padding: 2.5rem 1.75rem 2rem; }
        .auth-brand h1 { font-size: 2rem; }
    }
</style>

<div class="auth-page">

    <div class="auth-brand">
        <h1>Saudi Heritage</h1>
        <p>Dunes of Arabia · Travel Platform</p>
    </div>

    <div class="auth-card">
        <div class="card-icon">🛡️</div>
        <h2 class="card-title">Reset Your Password</h2>
        <p class="card-subtitle">Choose a strong new password for your account.</p>

        @if (Message != null)
        {
            <div class="alert-error">⚠️ @Message</div>
        }

        <StatusMessage Message="@Message" />
        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />

            <input type="hidden" name="Input.Code" value="@Input.Code" />

            <!-- EMAIL -->
            <div class="form-group">
                <label class="form-label" for="Input.Email">Email Address</label>
                <div class="input-wrapper">
                    <span class="input-icon">✉</span>
                    <InputText @bind-Value="Input.Email"
                               id="Input.Email"
                               class="form-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="your.email@example.com" />
                </div>
                <ValidationMessage For="() => Input.Email" class="validation-error" />
            </div>

            <!-- NEW PASSWORD + STRENGTH -->
            <div class="form-group">
                <label class="form-label" for="Input.Password">New Password</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔒</span>
                    <InputText type="password"
                               @bind-Value="Input.Password"
                               id="Input.Password"
                               class="form-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="••••••••"
                               @oninput="OnPasswordInput" />
                </div>
                <div class="strength-bar-wrap str-@strengthLevel">
                    <div class="strength-seg"></div>
                    <div class="strength-seg"></div>
                    <div class="strength-seg"></div>
                    <div class="strength-seg"></div>
                </div>
                <div class="strength-label" style="color: @strengthColor">@strengthText</div>
                <ValidationMessage For="() => Input.Password" class="validation-error" />
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-group">
                <label class="form-label" for="Input.ConfirmPassword">Confirm New Password</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔒</span>
                    <InputText type="password"
                               @bind-Value="Input.ConfirmPassword"
                               id="Input.ConfirmPassword"
                               class="form-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="••••••••" />
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" class="validation-error" />
            </div>

            <button type="submit" class="btn-primary">Set New Password</button>
        </EditForm>

        <div class="card-footer-text">
            <a href="/Account/Login">← Back to Sign In</a>
        </div>
    </div>

</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private int strengthLevel = 0;
    private string strengthText = "";
    private string strengthColor = "#BBA898";

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private string? Message => identityErrors is null ? null
        : $"Error: {string.Join(", ", identityErrors.Select(e => e.Description))}";

    protected override void OnInitialized()
    {
        Input ??= new();

        if (Code is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
            return;
        }

        Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        var pw = e.Value?.ToString() ?? "";
        int score = 0;
        if (pw.Length >= 8) score++;
        if (pw.Any(char.IsUpper)) score++;
        if (pw.Any(char.IsDigit)) score++;
        if (pw.Any(c => "!@#$%^&*()_+-=[]{}|;':\",./<>?".Contains(c))) score++;

        strengthLevel = pw.Length == 0 ? 0 : Math.Max(1, score);
        (strengthText, strengthColor) = strengthLevel switch
        {
            0 => ("", "#BBA898"),
            1 => ("Weak", "#DC2626"),
            2 => ("Fair", "#F59E0B"),
            3 => ("Good", "#10B981"),
            4 => ("Strong", "#059669"),
            _ => ("", "#BBA898")
        };
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        identityErrors = result.Errors;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, ErrorMessage = "Password must be at least {2} characters", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Code { get; set; } = "";
    }
}
